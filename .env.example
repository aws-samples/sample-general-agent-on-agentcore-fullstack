# Copy to .env and fill in real values.
# .env is gitignored; setup-lark.sh reads this file and writes the 
# credentials into Secrets Manager (the runtime source of truth).

# Every resource name starts with this name; changing it means a new deployment.
# 3-23 chars: lowercase letters, digits and hyphens, starting with a letter.
DEPLOYMENT_NAME=agentcore-fullstack

# The single source of deployment config: scripts pass these on to CDK, the Runtimes and the
# MCP servers, and stop if a required one is missing. Command-line env vars still win.
PROFILE=default
REGION=ap-northeast-1
# Open-weight by default: Kimi K3 (Moonshot AI) reads images and calls tools over Converse.
# Any Bedrock model with streaming tool use works; check image input and PROMPT_CACHE_TTL for yours.
MODEL_ID=global.moonshotai.kimi-k3

# Prompt-cache TTL for models that cache explicitly (Claude, Nova): 5m | 1h | off. The agent sends
# a cachePoint only for those; any other model (Kimi K3 included) caches implicitly and ignores this.
PROMPT_CACHE_TTL=5m

# The agent's system prompt. Leave blank to keep the default in agent/core.py, which
# is deliberately short: operational facts live in the tool descriptions instead.
AGENT_SYSTEM_PROMPT=

# Web search via the AgentCore Gateway connector.
# Off by default: the connector is only offered in us-east-1, 
# so enabling it provisions a gateway there and the agent calls it cross-region.
WEB_SEARCH=false
# AgentCore Policy on the Web Search Gateway: enforce (deny) or log_only (record what would be denied, deny nothing).
# Admins set the blocked domains on the web access page.
WEB_SEARCH_POLICY_MODE=enforce

# Code execution with a persistent per-user workspace (S3 Files mounted into a Code Interpreter session).
# Creates a VPC that only the sandbox joins; it reaches S3 through a free gateway endpoint and the Runtime stays PUBLIC. See docs/architecture.md.
FILES_STORAGE=false

# Internet for the code sandbox (pip/npm install, external APIs): adds one NAT gateway to that VPC, a fixed hourly charge plus data processing.
# Only applies with FILES_STORAGE=true. Off means the sandbox reaches S3 and nothing else; on means code the model writes can send data anywhere.
NAT_GATEWAY=false

# A web browser for the agent (AgentCore Browser, the AWS-managed aws.browser.v1): pages that need JavaScript, and working through a site.
# Creates nothing; bills per second while a browser runs. It reaches any website, so what a page says can carry data out — see docs/architecture.md.
BROWSER=false

# Where the agent Runtime runs: public (default) or vpc. Fixed for a deployment's life; changing it means destroy and redeploy.
# vpc with no subnets below creates a VPC: one NAT with a fixed outbound IP (a fixed hourly cost) and flow logs, shared with the code sandbox. Only the agent moves. See docs/architecture.md.
AGENT_NETWORK=public
# vpc only, optional: your own private subnets (two AgentCore-supported AZs, an S3 gateway endpoint) and security groups, comma-separated.
AGENT_SUBNET_IDS=
AGENT_SECURITY_GROUP_IDS=
# Created VPC only, optional: an Elastic IP allocation you own, so the outbound IP survives a redeploy.
EIP_ALLOCATION_ID=

# Where the agent image is built: codebuild (default; ARM64 native, needs no local Docker) or local (this host's Docker — fastest on an ARM64 machine, QEMU-emulated and slow elsewhere).
AGENT_BUILD=codebuild

# Web chat page (S3 + CloudFront, AG-UI over SSE), signed in to at a Cognito hosted login.
# Inside the Lark client it signs in through Lark instead, which needs an h5 app registered
# on the distribution's domain — see README step 5.
WEBUI=false
# Optional: a second web admin, invited by email. The deploy always creates admin@agentcore.local
# and prints its password (kept in Secrets Manager); admins invite users on the page's 管理 view.
WEB_ADMIN_EMAIL=

# Expose the agent to peer agents over A2A (a second Runtime on the same image).
# Off by default; scripts/a2a-demo.sh drives it once on.
A2A=false
# The name in the Agent Card — what a peer sees when it discovers this agent.
A2A_AGENT_NAME=agentcore-general-agent

# Lark open-platform host: https://open.larksuite.com (Lark) or https://open.feishu.cn (Feishu).
LARK_API_DOMAIN=https://open.larksuite.com

# Lark app credentials from the Lark developer console:
#   App ID / App Secret          -> Credentials & Basic Info
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Encrypt Key / Verify Token   -> Event Subscription > Encryption Strategy
LARK_ENCRYPT_KEY=xxxxxxxxxxxxxxxx
LARK_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Lark open_id (ou_...) to add to the allowlist. Leave blank to skip.
LARK_ADMIN_OPEN_ID=

# Approval automation (./deploy.sh approval). Enforced in code, never by the model —
# an approval form is untrusted input. Empty allow-list automates nothing.
# Note what this delegates: approve/reject accept only a tenant token, so the app
# completes the approval in the approver's name. Read docs/architecture.md first.
# Comma-separated, and must be quoted with no spaces — every script sources this
# file, so an unquoted comma+space makes the shell try to run the second value as a
# command and the variable ends up empty (which reads as "decide nothing").
AGENT_DECIDE_APPROVAL_CODES=""
# Only bites on forms that actually carry an amount — a travel request, say, has no
# amount field, so such approvals are gated by the allow-list alone. Not a catch-all.
AGENT_DECIDE_MAX_AMOUNT=1000

# Google as a second downstream system, to show the identity chain is not Lark-specific.
# A built-in AgentCore vendor, so this is the whole configuration — no shim, unlike Lark.
# Create an OAuth client in Google Cloud console; ./deploy.sh 3lo prints the redirect URI to
# register there. Scopes: openid/email/profile + calendar.readonly — enable the Calendar API
# in the project, add the scope under Data Access, and add yourself as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub as a downstream system, through GitHub's own MCP server (read-only by default).
# Create an OAuth App (GitHub → Settings → Developer settings → OAuth Apps); ./deploy.sh 3lo
# prints the callback URL to set as its Authorization callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: which GitHub MCP toolsets the agent gets, and "false" to allow writes.
# GITHUB_MCP_TOOLSETS=context,repos,issues,pull_requests,users
# GITHUB_MCP_READONLY=true
