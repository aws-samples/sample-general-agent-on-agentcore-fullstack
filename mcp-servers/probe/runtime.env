# Per-server build/runtime config, read by scripts/build-mcp.sh.

RUNTIME_SUFFIX=probe
IMAGE_TAG='src-$SRC_SHA'

# Never built by a build-everything run: this is a measurement tool, not part of the
# product. `./deploy.sh mcp probe` builds it explicitly when a platform question needs it.
DEPLOY_IF=PROBE_ENABLED

REQUIRE_VARS=""
RUNTIME_ENV_MAP=""
